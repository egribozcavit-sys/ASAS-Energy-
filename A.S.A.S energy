using System;
namespace Domain.Entities;
public class Battery : BaseEntity
{
    public string BatteryId { get; set; }
    public string SerialNumber { get; set; }
    public string Model { get; set; }
    public string Manufacturer { get; set; }
    public decimal Capacity { get; set; }
    public decimal? CurrentCharge { get; set; }
    public decimal? ChargePercent { get; set; }
    public decimal? Voltage { get; set; }
    public decimal? Current { get; set; }
    public decimal? Temperature { get; set; }
    public decimal? HealthPercent { get; set; }
    public DateTime? LastSeenAt { get; set; }
    public DeviceStatus Status { get; set; }
    public Battery(string batteryId, string serialNumber, string model, string manufacturer, decimal capacity)
    { BatteryId = batteryId; SerialNumber = serialNumber; Model = model; Manufacturer = manufacturer; Capacity = capacity; Status = DeviceStatus.Offline; }
    public void UpdateCharge(decimal currentCharge, decimal voltage, decimal current)
    { CurrentCharge = currentCharge; Voltage = voltage; Current = current; ChargePercent = (currentCharge / Capacity) * 100; LastSeenAt = DateTime.UtcNow; Status = currentCharge > 0 ? DeviceStatus.Online : DeviceStatus.Offline; }
    public void Charge(decimal amount) { CurrentCharge = Math.Min(Capacity, (CurrentCharge ?? 0) + amount); ChargePercent = (CurrentCharge / Capacity) * 100; }
    public void Discharge(decimal amount) { CurrentCharge = Math.Max(0, (CurrentCharge ?? 0) - amount); ChargePercent = (CurrentCharge / Capacity) * 100; }
    public void UpdateHealth(decimal healthPercent) { HealthPercent = healthPercent; }
}

