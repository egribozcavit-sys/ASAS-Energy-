using System;
namespace Domain.Entities;
public class SolarPanel : BaseEntity
{
    public string PanelId { get; set; }
    public string SerialNumber { get; set; }
    public string Model { get; set; }
    public string Manufacturer { get; set; }
    public decimal RatedPower { get; set; }
    public decimal? CurrentPower { get; set; }
    public decimal? Efficiency { get; set; }
    public string? Location { get; set; }
    public decimal? TotalEnergyProduced { get; set; }
    public decimal? Temperature { get; set; }
    public DateTime? LastSeenAt { get; set; }
    public DeviceStatus Status { get; set; }
    public SolarPanel(string panelId, string serialNumber, string model, string manufacturer, decimal ratedPower)
    { PanelId = panelId; SerialNumber = serialNumber; Model = model; Manufacturer = manufacturer; RatedPower = ratedPower; Status = DeviceStatus.Offline; }
    public void UpdatePower(decimal currentPower) { CurrentPower = currentPower; LastSeenAt = DateTime.UtcNow; Status = currentPower > 0 ? DeviceStatus.Online : DeviceStatus.Offline; }
    public decimal CalculateEfficiency() { if (RatedPower <= 0 || CurrentPower == null) return 0; return (CurrentPower.Value / RatedPower) * 100; }
    public void AddEnergyProduction(decimal energy) { TotalEnergyProduced = (TotalEnergyProduced ?? 0) + energy; }
}

