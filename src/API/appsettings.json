{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ASASEnergyDb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "YourSuperSecretJWTKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "ASAS.Energy",
    "ExpiryMinutes": 60
  },
  "IoT": {
    "MqttBroker": "localhost",
    "MqttPort": 1883
  },
  "Weather": {
    "ApiKey": "your_openweathermap_api_key",
    "ApiBaseUrl": "https://api.openweathermap.org"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log-.txt", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
